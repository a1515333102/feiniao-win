# ===== 工具链（体积大，按需自备，不做版本管理）=====
tools/

# ===== IDE 配置（含本机路径、数据源、会话状态，不入库）=====
.idea/
ky/.idea/
*.iml

# ===== 官方原始二进制与提取中间产物 =====
full.bin
extracted/
html_*.html

# ===== 上游 git 历史归档（仅本机保留）=====
.git-archived/

# ===== 编译产物（不入库，仓库只存源码）=====
dist/feiniao.exe
dist/*.exe
*.log
# 图标/版本资源由 build.bat 从 app.ico + versioninfo.json 现生成，不存生成物
ky/resource_windows_amd64.syso

# ===== 前端依赖与构建中间产物 =====
web/node_modules/
web/dist/
# 重新构建时旧产物先移到这里再替换,避免一次性删除触发保护
.build-tmp/

# ===== 运行时生成 =====
dist/权限测试.json
ky/.runtime/
ky/云函数/
dist/云函数/
ky/config.json
# dist/config.json 运行时会被写入数据库密码与快验 token，不提交；
# 仓库里保留一份空白模板 dist/config.example.json 供复制
dist/config.json
dist/*.log
# 在仓库根目录直接跑 exe 时程序也会在这里生成一份
/config.json

# ===== 本机配置备份（含支付商户密钥等敏感内容，绝不入库）=====
.local-backup/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 工作目录数据 =====
.workbuddy/
